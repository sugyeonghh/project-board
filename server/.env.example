# 서버 환경변수 예시. 실제 값은 운영 서버의 환경변수(또는 서비스 설정)에 넣고 이 파일은 커밋하지 않는다.
DB_URL=jdbc:mysql://localhost:3306/pmboard?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USER=pmboard
DB_PASSWORD=pmboard

# 32자 이상 아무 문자열 (로그인 토큰 서명용)
PMBOARD_JWT_SECRET=

# AI 키 암호화용 32바이트 키 (Base64). 한 번 정하면 바꾸지 말 것: 바꾸면 저장된 AI 키를 다시 등록해야 함
PMBOARD_SECRET_KEY=

# 첫 실행 때 만들어질 관리자 계정
PMBOARD_ADMIN_USER=admin
PMBOARD_ADMIN_PASSWORD=

# 첨부파일 저장 폴더
PMBOARD_STORAGE_DIR=./data/attachments

# 앱에서 오는 요청 허용 (기본값이면 생략)
# PMBOARD_CORS=http://localhost:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost
